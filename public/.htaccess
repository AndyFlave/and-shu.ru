# SPA fallback для Nuxt static (ssr: false)
# Все маршруты, не указывающие на существующий файл/директорию,
# отдают 200.html — клиентский роутер сам обработает путь.
#
# 200.html — это копия index.html, генерируется Nuxt'ом автоматически.
# Конвенция (Surge.sh, Nuxt static): отдаём shell с HTTP 200 для любых
# unknown-путей, чтобы SPA-роутер мог их перехватить вместо 404.
# Используем именно 200.html, а не index.html, чтобы избежать конфликтов
# с mod_dir (автоподстановка index.html для физических каталогов).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Не трогаем существующие файлы и директории
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Не трогаем папки поддоменов
  RewriteRule ^wishlist(/.*)?$ - [L]
  RewriteRule ^sites(/.*)?$ - [L]
  RewriteRule ^soundstorm-map(/.*)?$ - [L]
  RewriteRule ^bodyfolio(/.*)?$ - [L]

  # Всё остальное — на SPA fallback
  RewriteRule ^ /200.html [L]
</IfModule>

# Кэширование статических ассетов
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Сжатие
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Безопасность
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
